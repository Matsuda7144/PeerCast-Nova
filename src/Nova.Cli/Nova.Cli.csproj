<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nova.Core\Nova.Core.csproj" />
    <ProjectReference Include="..\Nova.Network\Nova.Network.csproj" />
    <ProjectReference Include="..\Nova.Playback\Nova.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-LICENSES\FFmpeg\**\*"
          Link="THIRD-PARTY-LICENSES\FFmpeg\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
