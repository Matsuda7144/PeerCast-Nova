root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_diagnostic.IDE0005.severity = warning

[src/Nova.Playback/PlaybackSourceBoundOneFrameDecodeBoundary.cs]
# Ordinary one-frame calls accept cancellation without a budget. The optional reusable
# cumulative budget intentionally remains a named trailing argument for bounded outer loops.
dotnet_diagnostic.CA1068.severity = none

[src/Nova.Playback/PlaybackPcpFlvAwaitedDecodeCompositionBoundary.cs]
# Cancellation can arrive as a subordinate fixed enum or through the linked stop token.
# The composition must latch terminal cleanup before translating either source outward,
# so a direct ThrowIfCancellationRequested replacement cannot preserve this contract.
dotnet_diagnostic.CA2250.severity = none

[src/Nova.Playback/PlaybackProductionDecoderGenerationFactory.cs]
# Pre-admission cancellation and disposal return a fixed creation result without mutating
# the lifecycle snapshot. Keep that result construction on the factory instance beside the
# stateful Finish path so the distinction remains explicit and reviewable.
dotnet_diagnostic.CA1822.severity = none

[src/Nova.Playback/PlaybackProductionDecoderGenerationIngressForwarding.cs]
# Forwarding must preserve the exact one-frame decode signature, where the optional reusable
# cumulative budget follows cancellation for compatibility with the owned decode boundary.
dotnet_diagnostic.CA1068.severity = none

[src/Nova.Playback/PlaybackProductionPcpFlvCompositionBoundary.cs]
# Fixed terminal exceptions are created beside the composition lifecycle rather than as a
# detached utility, keeping the public result translation explicit at every operation seam.
dotnet_diagnostic.CA1822.severity = none
# Cancellation can originate from subordinate fixed results or the linked stop token. The
# composition must finish terminal cleanup before translating cancellation to the caller.
dotnet_diagnostic.CA2250.severity = none
