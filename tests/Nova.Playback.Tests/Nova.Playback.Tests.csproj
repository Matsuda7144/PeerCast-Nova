<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit test names use underscores to separate behavior and expectation. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Nova.Core/Nova.Core.csproj" />
    <ProjectReference Include="../../src/Nova.Playback/Nova.Playback.csproj" />
    <ProjectReference Include="../../src/Nova.Encoding/Nova.Encoding.csproj" />
    <ProjectReference Include="../../src/Nova.Windows/Nova.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/fmp4-avc1-aac.mp4"
                      LogicalName="PeerCast.Nova.Playback.Tests.Fixtures.fmp4-avc1-aac.mp4" />
  </ItemGroup>
</Project>
